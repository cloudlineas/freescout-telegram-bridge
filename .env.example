# Copy to .env and fill in. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Your own numeric Telegram user ID (see README step 1b)
TELEGRAM_CHAT_ID=123456789

# Derived from FreeScout's APP_KEY -- see README step 2.
# On the server:
#   docker exec freescout sh -c 'printf "%s" "$(grep "^APP_KEY=" /www/html/.env | cut -d= -f2-)webhook_key" | md5sum | cut -d" " -f1'
FREESCOUT_WEBHOOK_SECRET=

# Base URL of your FreeScout install. Used to build the "Open in FreeScout"
# link. Leave empty to omit the link entirely.
FREESCOUT_URL=https://helpdesk.example.com

# Optional
EVENTS=convo.created,convo.customer.reply.created
MAILBOX_NAMES=1:Support,2:Sales
PREVIEW_CHARS=300
LOG_LEVEL=INFO
VERIFY_SIGNATURE=true
